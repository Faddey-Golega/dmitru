def check_winner(pole, mark):
    # Проверяем строки: если в одной строке все три клетки равны знаку (x или o)
    for r in range(1, 4):
        if pole[r][1] == pole[r][2] == pole[r][3] == mark:
            return True

    # Проверяем столбцы
    for c in range(1, 4):
        if pole[1][c] == pole[2][c] == pole[3][c] == mark:
            return True

    # Проверяем диагонали
    if pole[1][1] == pole[2][2] == pole[3][3] == mark:
        return True
    if pole[1][3] == pole[2][2] == pole[3][1] == mark:
        return True

    # Если ни одно условие не сработало — победы нет
    return False
